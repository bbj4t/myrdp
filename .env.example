# Copy this file to `.env` and fill in values. DO NOT commit `.env` with real credentials.
#
# Usage:
# 1) cp .env.example .env
# 2) Edit .env and set your values (DO NOT commit .env)
#
# Build-time args (if used by your docker-compose build)
VERSION_ARG=latest
TARGETARCH=amd64
PLATFORM=linux/amd64

# Runtime environment variables (container defaults)
VERSION=11
RAM_SIZE=8G
CPU_CORES=4
DISK_SIZE=64G

# Image / container settings
IMAGE_NAME=bbj4t/windows
CONTAINER_NAME=bbj4t-windows

# Ports (host:container)
PORT_RDP=3389
PORT_WEB=8006

# Named volume for persistent storage
STORAGE_VOLUME=windows_storage

# Docker Desktop installation settings
# If DOCKER_DOWNLOAD_URL is empty, the script will use the official stable download URL.
DOCKER_DESKTOP_VERSION=latest
DOCKER_DOWNLOAD_URL=

# WSL integration
WSL_ENABLE=true
WSL_DEFAULT_DISTRO=Ubuntu

# Docker Hub credentials (used by the installer script to run `docker login`)
# Prefer using a Personal Access Token (PAT) or access token instead of your main password.
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_PASSWORD=your-dockerhub-password-or-token

# Optional proxy settings for download and docker login (leave blank if not used)
HTTP_PROXY=
HTTPS_PROXY=

# Accept license automatically (set to "true" to auto-accept)
ACCEPT_DOCKER_LICENSE=true

# Helper flags
DETACH=true

# End of .env.example